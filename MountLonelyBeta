local function parsePath(raw)
    local out = {}
    for line in raw:gmatch("[^\r\n]+") do
        local t, px, py, pz = line:match(
            "t=([%-%d%.]+)%s*,%s*p=Vector3%.new%(([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%)")
        if t then
            out[#out+1] = { t = tonumber(t), p = Vector3.new(tonumber(px), tonumber(py), tonumber(pz)) }
        end
    end
    return out
end

local function computeCPIdxs()
    local out = {}
    for cp = 0, MAX_CP do
        local pos = CHECKPOINTS[cp]
        local bestI, bestD = 1, math.huge
        for i = 1, #Path do
            local d = (Path[i].p - pos).Magnitude
            if d < bestD then bestD = d; bestI = i end
        end
        out[cp] = { idx = bestI, dist = bestD, pos = pos }
    end
    return out
end

local function detectVerticalZones(path)
    local zones = {}
    local n = #path
    if n < 60 then return zones end
    local WINDOW = S.VZ_Window
    local MIN_DY = S.VZ_MinDY
    local MAX_DH = S.VZ_MaxDH

    local member = {}
    for i = 1, n - WINDOW do
        local p1 = path[i].p
        local p2 = path[i + WINDOW].p
        local dY = math.abs(p2.Y - p1.Y)
        local dx, dz = p2.X - p1.X, p2.Z - p1.Z
        local dH = math.sqrt(dx*dx + dz*dz)
        if dY >= MIN_DY and dH <= MAX_DH then
            for j = i, math.min(n, i + WINDOW) do member[j] = true end
        end
    end

    local inZone, startIdx = false, nil
    for i = 1, n do
        if member[i] and not inZone then inZone = true; startIdx = i
        elseif not member[i] and inZone then
            inZone = false
            zones[#zones+1] = { startIdx = startIdx, endIdx = i - 1 }
        end
    end
    if inZone then zones[#zones+1] = { startIdx = startIdx, endIdx = n } end
    return zones
end

local function loadData()
    log("Downloading path...")
    local ok, raw = pcall(function() return game:HttpGet(PATH_URL, true) end)
    if not ok or not raw then LoadErr = "HttpGet failed"; return false end
    Path = parsePath(raw)
    if #Path == 0 then LoadErr = "Parsed 0 frames"; return false end

    S.CPIdxs = computeCPIdxs()
    log(string.format("Loaded %d frames (%.1fs).", #Path, Path[#Path].t))
    for cp = 0, MAX_CP do
        local e = S.CPIdxs[cp]
        if e then
            local tag = (cp == RESET_CP) and "  [RESET]" or ""
            log(string.format("  CP%-2d → idx %-5d (%.1f studs)%s", cp, e.idx, e.dist, tag))
        end
    end

    S.VerticalZones = detectVerticalZones(Path)
    log(string.format("Detected %d vertical zones:", #S.VerticalZones))
    for i, z in ipairs(S.VerticalZones) do
        local p1, p2 = Path[z.startIdx].p, Path[z.endIdx].p
        local dY = math.abs(p2.Y - p1.Y)
        local dH = Vector3.new(p2.X - p1.X, 0, p2.Z - p1.Z).Magnitude
        log(string.format("  VZ #%d: idx %d-%d dY=%.1f dH=%.1f dur=%.1fs",
            i, z.startIdx, z.endIdx, dY, dH, Path[z.endIdx].t - Path[z.startIdx].t))
    end

    S.Jumps = {}
    local n = #Path
    local i = 2
    while i <= n - 1 do
        local dy = Path[i].p.Y - Path[i-1].p.Y
        local dt = Path[i].t - Path[i-1].t
        if dt > 0 and dy/dt > 20 and dy/dt < 200 then
            S.Jumps[#S.Jumps+1] = { idx = i, fired = false }
            local stop = Path[i].t + 0.4
            while i <= n and Path[i].t < stop do i = i + 1 end
        else
            i = i + 1
        end
    end

    Loaded = true
    LoadErr = ""
    return true
end

local function refreshVerticalZones()
    if #Path == 0 then return end
    S.VerticalZones = detectVerticalZones(Path)
    log(string.format("Re-detected %d vertical zones with new thresholds.", #S.VerticalZones))
end

