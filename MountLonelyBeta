local function nearestFrame(pos, hintIdx, wide)
    local win = wide and 200 or 30
    local lo = math.max(1, (hintIdx or 1) - win)
    local hi = math.min(#Path, (hintIdx or 1) + win)
    local bestI, bestD = lo, math.huge
    for i = lo, hi do
        local d = (Path[i].p - pos).Magnitude
        if d < bestD then bestD = d; bestI = i end
    end
    return bestI, bestD
end

local function fullNearestFrame(pos)
    local bestI, bestD = 1, math.huge
    for i = 1, #Path, 3 do
        local d = (Path[i].p - pos).Magnitude
        if d < bestD then bestD = d; bestI = i end
    end
    return bestI, bestD
end

local function forceJump(hh)
    pcall(function() hh.Jump = true end)
    pcall(function() hh:ChangeState(Enum.HumanoidStateType.Jumping) end)
end

local function pickHorizTarget(fromPos, startIdx, extraSkip, minHoriz)
    local start = math.min(startIdx + extraSkip, #Path)
    for i = start, math.min(#Path, start + 60) do
        local p = Path[i].p
        local delta = p - fromPos
        local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude
        if horiz >= minHoriz then return i end
    end
    return math.min(#Path, start + 60)
end

local function getCheckpointValue()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return nil end
    local cp = ls:FindFirstChild("Checkpoint")
    if not cp then return nil end
    return tonumber(cp.Value) or 0
end

local function stopPlayback()
    log(string.format("Stopped. Frames: %d, Jumps: %d, Escapes: %d, CPs: %d",
        S.Frames, S.JumpCount, S.EscapeCount, S.RegisteredCount))
    S.Enabled = false
    if S.Conn then S.Conn:Disconnect(); S.Conn = nil end
    if S.MoveConn then S.MoveConn:Disconnect(); S.MoveConn = nil end
    local c = LocalPlayer.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = 16; h.JumpPower = 50; h:Move(Vector3.zero) end
    end
    for _, ev in ipairs(S.Jumps) do ev.fired = false end
    S.CurrentVerticalZone = nil
    S.State = "waiting"
end

local function beginPause(cpNumber, cpPos, now)
    S.State           = "pausing"
    S.PauseCPPos      = cpPos
    S.PauseCPNumber   = cpNumber
    S.PauseStartTime  = now
    S.PausePollAt     = 0
    S.PauseLastWarn   = now
    S.PausePhase      = "approach"
    S.PauseHoldStart  = 0
    S.SearchAngle     = 0
    S.SearchCircles   = 0
    S.SearchLastTick  = now
    S.MoveDir         = Vector3.zero
    if cpNumber == RESET_CP then
        log("[CP-BEGIN] CP22 (RESET) — heading to reset point")
    else
        log(string.format("[CP-BEGIN] CP%d", cpNumber))
    end
end

local function checkPauseSuccess(cpNow)
    if cpNow == nil then return false end
    if S.PauseCPNumber == RESET_CP then return cpNow == 0 end
    return cpNow >= S.PauseCPNumber
end

local function completePause(cpNow, now)
    S.RegisteredCount = S.RegisteredCount + 1
    local elapsed = now - S.PauseStartTime

    if S.PauseCPNumber == RESET_CP then
        log(string.format("[CP-OK] CP22 RESET! cp=%d, %.1fs", cpNow, elapsed))
        S.PauseCPPos, S.PauseCPNumber = nil, nil
        S.ExpectedCP = 1
        S.LastProgressAt = now
        if S.Loop then
            S.State = "waiting_base_camp"
            S.ResetWaitStart = now
            log("[CP22] Waiting for base-camp teleport...")
        else
            log("[CP22] Loop off. Stopping.")
            stopPlayback()
        end
        return
    end

    log(string.format("[CP-OK] CP%d registered! cp=%d, %.1fs (phase=%s, circles=%d)",
        S.PauseCPNumber, cpNow, elapsed, S.PausePhase, S.SearchCircles))
    S.ExpectedCP = cpNow + 1
    S.State      = "following"
    S.PauseCPPos, S.PauseCPNumber = nil, nil
    S.LastProgressAt = now

    -- Loop OFF stops after CP21
    if not S.Loop and cpNow >= 21 then
        log("[END] Loop off + CP21 → summit reached. Stopping.")
        stopPlayback()
        return
    end
end

local function reanchorToBaseCamp(now, reason)
    log(string.format("[REANCHOR] %s → restarting from 0%%", reason))
    S.TrackIdx        = 1
    S.LastProgressIdx = 1
    S.LastProgressAt  = now
    S.LastEscapeIdx   = 0
    S.EscapeLevel     = 0
    S.EscapeCount     = 0
    S.JumpCount       = 0
    S.Frames          = 0
    S.RegisteredCount = 0
    S.ExpectedCP      = 1
    S.CurrentVerticalZone = nil
    for _, ev in ipairs(S.Jumps) do ev.fired = false end
    S.State = "following"
end

local function updateVerticalZone(now)
    local inZone, currentZone = false, nil
    for _, z in ipairs(S.VerticalZones) do
        if S.TrackIdx >= z.startIdx and S.TrackIdx <= z.endIdx then
            inZone = true
            currentZone = z
            break
        end
    end

    if inZone and not S.CurrentVerticalZone then
        S.JumpPowerSaved = S.JumpPower
        S.AltitudeCapSaved = S.AltitudeCap
        S.JumpPower = 100
        S.AltitudeCap = 50
        S.CurrentVerticalZone = currentZone
        local dY = math.abs(Path[currentZone.endIdx].p.Y - Path[currentZone.startIdx].p.Y)
        log(string.format("[VERTICAL-IN] idx %d-%d (dY=%.1f). JP %d→100, AltCap %d→50",
            currentZone.startIdx, currentZone.endIdx, dY,
            S.JumpPowerSaved, S.AltitudeCapSaved))
    elseif not inZone and S.CurrentVerticalZone then
        log(string.format("[VERTICAL-OUT] restore JP=%d AltCap=%d",
            S.JumpPowerSaved or 100, S.AltitudeCapSaved or 12))
        S.JumpPower = S.JumpPowerSaved or 100
        S.AltitudeCap = S.AltitudeCapSaved or 12
        S.CurrentVerticalZone = nil
    end
end

-- ═══════════════════════════════════════════════════════
-- HEARTBEAT
-- ═══════════════════════════════════════════════════════
local function heartbeatBody()
    local now = os.clock()
    if not S.Enabled then return end

    local c = LocalPlayer.Character
    if not c then return end
    local h  = c:FindFirstChild("HumanoidRootPart")
    local hh = c:FindFirstChildOfClass("Humanoid")
    if not h or not hh then return end

    local myPos = h.Position
    local state = hh:GetState()
    local cpNow = getCheckpointValue()

    -- WAITING
    if S.State == "waiting" then
        if (now - S.WaitStart) < 3 then return end
        if cpNow == nil then return end
        local onGround = (state == Enum.HumanoidStateType.Running
                      or state == Enum.HumanoidStateType.RunningNoPhysics
                      or state == Enum.HumanoidStateType.Landed
                      or state == Enum.HumanoidStateType.Seated
                      or state == Enum.HumanoidStateType.Standing)
        if onGround then
            hh.WalkSpeed     = tonumber(S.WalkSpeed) or 200
            hh.UseJumpPower  = true
            hh.JumpPower     = tonumber(S.JumpPower) or 100
            hh.PlatformStand = false
            hh.AutoRotate    = true
            S.TrackIdx = fullNearestFrame(myPos)
            S.LastProgressIdx = S.TrackIdx
            S.LastProgressAt  = now
            S.ExpectedCP      = cpNow + 1
            S.State = "following"
            log(string.format("Following from idx %d. cp=%d, expecting CP%d",
                S.TrackIdx, cpNow, S.ExpectedCP))
        end
        return
    end

    -- WAITING FOR BASE CAMP
    if S.State == "waiting_base_camp" then
        S.MoveDir = Vector3.zero
        local cp0 = CHECKPOINTS[0]
        local dist = (myPos - cp0).Magnitude

        if (now - S.PauseLastWarn) > 3 then
            S.PauseLastWarn = now
            log(string.format("[CP22-WAIT] at (%.1f,%.1f,%.1f), dist=%.1f, cp=%s",
                myPos.X, myPos.Y, myPos.Z, dist, tostring(cpNow)))
        end
        if dist <= S.ResetArriveDist then
            reanchorToBaseCamp(now, string.format("arrived (dist=%.1f)", dist)); return
        end
        if (now - S.ResetWaitStart) > S.ResetWaitMax then
            reanchorToBaseCamp(now, string.format("timeout (dist=%.1f)", dist)); return
        end
        return
    end

    -- PAUSING
    if S.State == "pausing" then
        S.LastProgressAt = now

        if (now - S.PausePollAt) >= 0.15 then
            S.PausePollAt = now
            if checkPauseSuccess(cpNow) then
                completePause(cpNow, now); return
            end
        end

        if (now - S.PauseStartTime) >= S.PauseTimeout then
            log(string.format("[CP-TIMEOUT] CP%d unresolved in %ds. Aborting.",
                S.PauseCPNumber, S.PauseTimeout))
            stopPlayback(); return
        end

        if (now - S.PauseLastWarn) > 5 then
            S.PauseLastWarn = now
            local dist = S.PauseCPPos and (myPos - S.PauseCPPos).Magnitude or -1
            log(string.format("[CP-WAIT] CP%d %.1fs cp=%s phase=%s circles=%d dist=%.1f",
                S.PauseCPNumber, now - S.PauseStartTime, tostring(cpNow),
                S.PausePhase, S.SearchCircles, dist))
        end

        local cpPos = S.PauseCPPos
        if not cpPos then S.MoveDir = Vector3.zero; return end

        if S.PausePhase == "approach" then
            local dist = (myPos - cpPos).Magnitude
            if dist <= 3 then
                S.PausePhase    = "hold"
                S.PauseHoldStart = now
                S.MoveDir       = Vector3.zero
                log(string.format("[CP-HOLD] CP%d arrived (dist %.1f). Holding %.1fs.",
                    S.PauseCPNumber, dist, S.PauseHoldDur))
            else
                local delta = cpPos - myPos
                local horiz = Vector3.new(delta.X, 0, delta.Z)
                S.MoveDir = horiz.Magnitude > 0.5 and horiz.Unit or Vector3.zero
            end
            return
        end

        if S.PausePhase == "hold" then
            S.MoveDir = Vector3.zero
            if (now - S.PauseHoldStart) >= S.PauseHoldDur then
                S.PausePhase     = "search"
                S.SearchAngle    = 0
                S.SearchCircles  = 0
                S.SearchLastTick = now
                log(string.format("[CP-SEARCH] CP%d starting circular search", S.PauseCPNumber))
            end
            return
        end

        if S.PausePhase == "search" then
            local dt = now - S.SearchLastTick
            S.SearchLastTick = now
            if dt > 0.25 then dt = 0.25 end
            S.SearchAngle = S.SearchAngle + S.SearchAngSpeed * dt
            if S.SearchAngle >= math.pi * 2 then
                S.SearchAngle = S.SearchAngle - math.pi * 2
                S.SearchCircles = S.SearchCircles + 1
                local r = math.min(S.SearchBaseR + S.SearchCircles * S.SearchStepR, S.SearchMaxR)
                log(string.format("[CP-CIRCLE] CP%d circle %d → radius %.1f",
                    S.PauseCPNumber, S.SearchCircles, r))
            end
            local radius = math.min(S.SearchBaseR + S.SearchCircles * S.SearchStepR, S.SearchMaxR)
            local desired = Vector3.new(
                cpPos.X + math.cos(S.SearchAngle) * radius, cpPos.Y,
                cpPos.Z + math.sin(S.SearchAngle) * radius)
            local delta = desired - myPos
            local horiz = Vector3.new(delta.X, 0, delta.Z)
            S.MoveDir = horiz.Magnitude > 0.8 and horiz.Unit or Vector3.zero
            return
        end
        return
    end

    -- FOLLOWING
    local wideSearch = (S.EscapeLevel > 0)
    local nearIdx = nearestFrame(myPos, S.TrackIdx, wideSearch)
    if nearIdx > S.TrackIdx then S.TrackIdx = nearIdx end

    if S.TrackIdx > S.LastProgressIdx then
        S.LastProgressIdx = S.TrackIdx
        S.LastProgressAt  = now
        if S.EscapeLevel > 0 and (S.TrackIdx - S.LastEscapeIdx) > S.ResetDistance then
            S.EscapeLevel = 0
            S.LastEscapeIdx = 0
        end
    end

    updateVerticalZone(now)

    S.ExpectedCP = (cpNow or 0) + 1

    if not S.Loop and (cpNow or 0) >= 21 then
        log("[END] Loop off + CP21 → stopping at summit.")
        stopPlayback(); return
    end

    if S.ExpectedCP <= MAX_CP then
        local e = S.CPIdxs[S.ExpectedCP]
        if e and S.TrackIdx >= e.idx - 8 then
            beginPause(S.ExpectedCP, e.pos, now); return
        end
    end

    local stalledFor = now - S.LastProgressAt
    local stallTrigger = tonumber(S.StallTrigger) or 1.0
    if stalledFor > stallTrigger
       and (now - S.LastEscapeAt) > S.EscapeCooldown then

        S.EscapeLevel = math.min(S.EscapeLevel + 1, #ESCAPE_DIST)
        local adv = ESCAPE_DIST[S.EscapeLevel]
        local targetIdx = math.min(S.TrackIdx + adv, #Path)

        if S.ExpectedCP <= MAX_CP then
            local e = S.CPIdxs[S.ExpectedCP]
            if e and targetIdx > e.idx - 5 then
                targetIdx = math.max(S.TrackIdx + 10, e.idx - 5)
                log(string.format("[ESCAPE-CLAMP] clamped to idx %d", targetIdx))
            end
        end

        local tpPos = Path[targetIdx].p
        local pathY = Path[S.TrackIdx].p.Y
        local altOffset = math.clamp(myPos.Y - pathY, 5, 15)
        local dest = Vector3.new(tpPos.X, tpPos.Y + altOffset, tpPos.Z)

        pcall(function() h.CFrame = CFrame.new(dest) end)
        pcall(function()
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end)

        S.LastEscapeAt   = now
        S.EscapeCount    = S.EscapeCount + 1
        S.LastProgressIdx = targetIdx
        S.LastProgressAt  = now
        S.LastEscapeIdx   = targetIdx
        S.TrackIdx       = targetIdx

        log(string.format("[ESCAPE-L%d] stall %.1fs → idx=%d",
            S.EscapeLevel, stalledFor, targetIdx))
        return
    end

    -- Normal follow
    local pathY = Path[S.TrackIdx].p.Y
    local altAbove = myPos.Y - pathY

    local baseAhead = S.TrackIdx + (tonumber(S.LookAhead) or 8)
    local targetIdx = pickHorizTarget(myPos, baseAhead, 0, 1.5)
    local target = Path[targetIdx].p

    local delta = target - myPos
    local horiz = Vector3.new(delta.X, 0, delta.Z)
    S.MoveDir = horiz.Magnitude > 0.5 and horiz.Unit or Vector3.zero

    S.Frames = S.Frames + 1
    if hh.WalkSpeed ~= S.WalkSpeed then hh.WalkSpeed = tonumber(S.WalkSpeed) or 200 end
    if hh.JumpPower ~= S.JumpPower then
        pcall(function() hh.UseJumpPower = true; hh.JumpPower = S.JumpPower end)
    end

    local altCap = tonumber(S.AltitudeCap) or 12
    local jumpInterval = tonumber(S.JumpInterval) or 0.18

    if S.JumpEnabled
       and altAbove < altCap
       and (now - S.LastJumpAt) > jumpInterval then
        forceJump(hh)
        S.LastJumpAt = now
        S.JumpCount = S.JumpCount + 1
    end

    for _, ev in ipairs(S.Jumps) do
        if not ev.fired and S.TrackIdx >= ev.idx and altAbove < altCap then
            ev.fired = true
            forceJump(hh)
        end
    end

    if S.TrackIdx >= #Path - 3 then
        if S.Loop then
            reanchorToBaseCamp(now, "reached end of path"); return
        else
            log("End of path."); stopPlayback(); return
        end
    end

    if (now - S.DiagAt) >= 1 then
        S.DiagAt = now
        local pct = math.floor(S.TrackIdx / #Path * 100)
        local vz = S.CurrentVerticalZone and "VZ" or "--"
        log(string.format(
            "idx=%d (%d%%) cp=%s exp=%d done=%d esc=%d stall=%.1fs vz=%s JP=%d alt=%d",
            S.TrackIdx, pct, tostring(cpNow),
            S.ExpectedCP, S.RegisteredCount, S.EscapeCount,
            stalledFor, vz, S.JumpPower, S.AltitudeCap))
    end
end

local function startPlayback()
    if S.Enabled then return end
    local c = LocalPlayer.Character
    if not c then log("No character."); return end

    for _, ev in ipairs(S.Jumps) do ev.fired = false end

    S.Enabled         = true
    S.State           = "waiting"
    S.WaitStart       = os.clock()
    S.Frames          = 0
    S.DiagAt          = 0
    S.TrackIdx        = 1
    S.LastProgressIdx = 1
    S.LastProgressAt  = os.clock()
    S.LastEscapeIdx   = 0
    S.JumpCount       = 0
    S.LastJumpAt      = 0
    S.MoveDir         = Vector3.zero
    S.LastEscapeAt    = 0
    S.EscapeLevel     = 0
    S.EscapeCount     = 0
    S.RegisteredCount = 0
    S.PauseCPPos      = nil
    S.PauseCPNumber   = nil
    S.ResetWaitStart  = 0
    S.CurrentVerticalZone = nil
    S.JumpPowerSaved  = S.JumpPower
    S.AltitudeCapSaved = S.AltitudeCap

    log("Waiting 3s for map...")

    S.MoveConn = RunService.RenderStepped:Connect(function()
        if not S.Enabled then return end
        local cc = LocalPlayer.Character
        if not cc then return end
        local hhh = cc:FindFirstChildOfClass("Humanoid")
        if not hhh then return end
        if S.State == "waiting_base_camp" then
            hhh:Move(Vector3.zero, false)
        elseif S.MoveDir.Magnitude > 0.05 then
            hhh:Move(S.MoveDir, false)
        else
            hhh:Move(Vector3.zero, false)
        end
    end)

    S.Conn = RunService.Heartbeat:Connect(function()
        local ok, err = xpcall(heartbeatBody, function(e)
            return tostring(e) .. "\n" .. debug.traceback("", 2)
        end)
        if not ok then warn("[AutoSummit] Error:", err) end
    end)

    log("Playback started.")
end

